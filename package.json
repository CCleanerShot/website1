{
  "name": "src",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "deleteold": "rimraf dist",
    "makehtml": "mkdir ./dist/frontend/ && cp ./src/frontend/*.html ./dist/frontend/",
    "maketailwind": "npx tailwindcss -i ./src/frontend/styles.css -o ./dist/frontend/styles.css",
    "makejs": "cp ./src/frontend/*.js ./dist/frontend/",
    "makefrontend": "npm run makehtml && npm run maketailwind && npm run makejs",
    "makebackend": "npx tsc",
    "backend": "node dist/backend/index.js",
    "frontend": "live-server dist/frontend/",
    "build": "npm run deleteold && npm run makebackend && npm run makefrontend",
    "prestart": "npm run build",
    "start": "npm run frontend & npm run backend",
    "preserve": "npm run build",
    "serve": "npx tsc --watch & nodemon ./dist/backend/index.js & npx tailwindcss -i ./src/frontend/styles.css -o ./dist/frontend/styles.css --watch"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.1",
    "tailwindcss": "^3.3.3",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs": "^0.0.1-security"
  }
}
