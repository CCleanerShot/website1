{
  "name": "website1",
  "version": "1.0.0",
  "description": "test website i make in 1 week",
  "main": "index.js",
  "scripts": {
    "makedist": "mkdir ./dist && mkdir ./dist/web && mkdir ./dist/dev",
    "makehtml": "cp ./src/web/*.html ./dist/web/",
    "makedev": "cp ./src/dev/*.js ./dist/dev/",
    "build": "rimraf dist && npm run makedist && npm run makehtml && npm run makedev",
    "preserve": "npm run build",
    "serve": "npx tailwindcss -i ./src/web/styles.css -o ./dist/web/styles.css --watch"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "rimraf": "^5.0.1",
    "tailwindcss": "^3.3.3"
  }
}
